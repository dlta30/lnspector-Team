{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3en",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": [
    "python_workers"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "3en-inspect",
      "database_id": "74bef233-d581-4204-8584-4539300c0805",
      "migrations_dir": "migrations"
    }
  ]
}
